# Leave empty in development to use the Vite /api proxy.
# Set this to the deployed backend API base URL in production.
VITE_API_URL=

# Firebase Client Configuration (Firebase Console -> Project Settings -> General -> Your Apps -> Web App)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
