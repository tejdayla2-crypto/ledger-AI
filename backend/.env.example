# Copy to .env and fill in private values. Never commit .env.
GEMINI_API_KEY=your_real_key_here
JWT_SECRET=your_long_random_secret_at_least_32_characters_long
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Firebase Admin Configuration (Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key)
# Option 1: File path to downloaded service account json (relative to backend folder or absolute)
FIREBASE_SERVICE_ACCOUNT_KEY=./firebase-service-account.json

# Option 2: Individual credentials (alternative to service account json file)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
